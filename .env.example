# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# OpenAI: the colour consultant. Without a key the site runs in demo mode: it still suggests three
# catalogue colours with real costs, chosen from the brief by simple rules, and says so on the page.
# Add the key in Vercel as type Sensitive. Never commit it.
OPENAI_API_KEY=
# Model and reasoning effort (none | low | medium | high | xhigh). Defaults: gpt-5.5, low.
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
# The image model that paints the "See it in your room" previews of the customer's photo, and its
# quality (low | medium | high | xhigh | max). Higher quality looks better but costs more per image.
# Defaults: gpt-image-2.5-sunburst, medium.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
# Optional: the key that signs preview tokens. Without it, one is derived from OPENAI_API_KEY.
PREVIEW_SECRET=
# Only for tests: point the client at a local mock of the OpenAI API.
OPENAI_BASE_URL=

# Public URL of the site (canonical links). Leave empty locally.
PUBLIC_SITE_URL=

# Order requests by email (Resend). Without these, the order form is hidden and orders go by WhatsApp.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# The daily job that emails sample customers a few days after delivery (vercel.json "crons").
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>"; without it the job doesn't run.
# Any long random string, e.g. from `openssl rand -hex 32`. Add it in Vercel as Sensitive.
CRON_SECRET=
