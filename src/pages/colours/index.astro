---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Swatch from '../../components/Swatch.astro';
import copy from '../../content/copy.json';
import { FAMILIES, TONES, colours, getBrand, sellingBrands } from '../../lib/catalogue';
import { colourQueryString, parseColourQuery, searchColours } from '../../lib/colour-search';
import { fill } from '../../lib/money';

const c = copy.colours;
const query = parseColourQuery(Astro.url.searchParams);
const { total, page, pages, items } = searchColours(query);
const filtered = Boolean(query.q || query.brand || query.family || query.tone);
const countText = `${total.toLocaleString('en-US')} colour${total === 1 ? '' : 's'}`;
const link = (change: Parameters<typeof colourQueryString>[1]) => `/colours${colourQueryString(query, { page: 1, ...change })}`;

// Same results for everyone, so the CDN can keep each filtered page for an hour.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');
---

<Base title={c.seo.title} description={c.seo.description} noindex={filtered || page > 1}>
  <section class="bj-container bj-section bj-stack" data-bj-colours>
    <div class="bj-stack" style="--bj-stack-gap:12px">
      <h1>{c.title}</h1>
      <p class="bj-lead">{fill(c.intro, { count: colours.length.toLocaleString('en-US') })}</p>
      <p><a class="bj-link-arrow" href="/colour-consultant"><Icon name="spark" />{c.notSure}</a></p>
    </div>

    <form class="bj-colour-search" method="get" action="/colours" role="search" aria-label="Colours">
      <div class="bj-field bj-colour-search__q">
        <label for="colour-q">{c.searchLabel}</label>
        <input class="bj-input" id="colour-q" name="q" type="search" value={query.q} placeholder={c.searchPlaceholder} autocomplete="off" />
      </div>
      <div class="bj-field">
        <label for="colour-brand">Brand</label>
        <select class="bj-input" id="colour-brand" name="brand">
          <option value="">All brands</option>
          {sellingBrands.map((b) => <option value={b.id} selected={query.brand === b.id}>{b.name}</option>)}
        </select>
      </div>
      <div class="bj-field">
        <label for="colour-family">Colour</label>
        <select class="bj-input" id="colour-family" name="family">
          <option value="">All colours</option>
          {FAMILIES.map((f) => <option value={f.id} selected={query.family === f.id}>{f.label}</option>)}
        </select>
      </div>
      <div class="bj-field">
        <label for="colour-tone">Lightness</label>
        <select class="bj-input" id="colour-tone" name="tone">
          <option value="">Any</option>
          {TONES.map((t) => <option value={t.id} selected={query.tone === t.id}>{t.label}</option>)}
        </select>
      </div>
      <button class="bj-button" type="submit">Show colours</button>
    </form>

    <nav class="bj-chips" aria-label="Colour families">
      <a class="bj-chip-button" href={link({ family: null })} aria-current={query.family === null ? 'true' : undefined}>All</a>
      {FAMILIES.map((f) => <a class="bj-chip-button" href={link({ family: f.id })} aria-current={query.family === f.id ? 'true' : undefined}>{f.label}</a>)}
    </nav>

    <div class="bj-row" style="justify-content:space-between">
      <p class="bj-small bj-muted" role="status">{countText}{pages > 1 ? `, page ${page} of ${pages}` : ''}</p>
      {filtered && <a class="bj-small" href="/colours">Clear filters</a>}
    </div>

    {
      total === 0 ? (
        <div class="bj-stack" style="--bj-stack-gap:12px">
          <p class="bj-lead">{c.none}</p>
          <div><a class="bj-button bj-button--secondary" href="/colours">See all colours</a></div>
        </div>
      ) : (
        <ul class="bj-colour-grid bj-colour-grid--compact">
          {items.map((col) => (
            <li>
              <a class="bj-colour-tile" href={`/colours/${col.id}`}>
                <Swatch hex={col.hex} class="bj-colour-tile__swatch" />
                <span class="bj-colour-tile__text">
                  <strong>{col.name}</strong>
                  <span>{getBrand(col.brand)?.name}{col.code ? ` · ${col.code}` : ''}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      pages > 1 && (
        <nav class="bj-pager" aria-label="Pages of colours">
          {page > 1 ? <a class="bj-button bj-button--secondary" href={`/colours${colourQueryString(query, { page: page - 1 })}`} rel="prev">Previous</a> : <span />}
          <span class="bj-small bj-muted">Page {page} of {pages}</span>
          {page < pages ? <a class="bj-button bj-button--secondary" href={`/colours${colourQueryString(query, { page: page + 1 })}`} rel="next">Next</a> : <span />}
        </nav>
      )
    }
  </section>
</Base>
