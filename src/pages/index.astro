---
import Base from '../layouts/Base.astro';
import HomeDemo from '../components/HomeDemo.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import type { IconName } from '../lib/icons';
import copy from '../content/copy.json';
import { colours, getBrand, samples, sellingBrands, type ColourFamily } from '../lib/catalogue';
import { deliveryDays } from '../lib/business';
import { fill, formatZar } from '../lib/money';
import { photos } from '../lib/photos';

const home = copy.home;
// One real colour from each of three families, for the paint chips over the hero photo.
const fanFamilies: ColourFamily[] = ['green', 'neutral', 'pink-terracotta'];
const fan = fanFamilies
  .map((family) => colours.find((c) => c.family === family))
  .filter((c) => c !== undefined);
const turns = [-14, 0, 14];
const cheapestSampleCents = Math.min(...samples.flatMap((s) => Object.values(s.prices).filter((c): c is number => typeof c === 'number')));
const factIcons: IconName[] = ['swatch', 'tin', 'delivery'];
---

<Base title={home.seo.title} description={home.seo.description}>
  <section class="bj-container bj-paint-hero">
    <div class="bj-stack">
      <span class="bj-eyebrow bj-icon-text"><Icon name="spark" />{home.eyebrow}</span>
      <h1>{home.title}</h1>
      <p class="bj-lead">{home.body}</p>
      <div class="bj-row">
        <a class="bj-button" href="/colour-consultant"><Icon name="camera" />{home.primaryCta}</a>
        <a class="bj-button bj-button--secondary" href="/colours">{home.secondaryCta}</a>
      </div>
      <ul class="bj-facts" aria-label="Why Big Jo’s Paints">
        {home.facts.map((fact, i) => <li><Icon name={factIcons[i]} />{fact.replace('3 days', `${deliveryDays} days`)}</li>)}
      </ul>
    </div>
    <Photo photo={photos.diningRoom} class="bj-hero-photo" loading="eager" sizes="(min-width: 1200px) 480px, (min-width: 900px) 40vw, (min-width: 560px) 480px, 100vw" focus="50% 40%">
      <div class="bj-fan" aria-hidden="true">
        {
          fan.map((c, i) => (
            <div class="bj-fan__chip" style={`--bj-chip: ${c.hex}; --bj-turn: ${turns[i] ?? 0}deg`}>
              <strong>{c.name}</strong>
              <span>{getBrand(c.brand)?.name}</span>
            </div>
          ))
        }
      </div>
    </Photo>
  </section>

  <HomeDemo />

  <section class="bj-container bj-section bj-stack" aria-labelledby="steps-title">
    <h2 id="steps-title">{home.stepsTitle}</h2>
    <ol class="bj-steps">
      {
        home.steps.map((step) => (
          <li>
            <Icon name={step.icon as IconName} />
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div><a class="bj-button" href="/colour-consultant">{home.primaryCta}</a></div>
  </section>

  <section class="bj-green bj-section">
    <div class="bj-container bj-grid">
      <h2>{home.aiTitle}</h2>
      <div class="bj-stack">
        {home.aiBody.map((p) => <p>{p}</p>)}
        <a class="bj-link-arrow" href="/help#ai">How it works<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="bj-container bj-section bj-split" aria-labelledby="samples-title">
    <Photo photo={photos.testPatches} class="bj-split__photo" sizes="(min-width: 900px) 40vw, 100vw" focus="50% 72%" />
    <div class="bj-stack">
      <h2 id="samples-title">{home.samplesTitle}</h2>
      <p class="bj-lead">{fill(home.samplesBody, { price: formatZar(cheapestSampleCents) })}</p>
      <a class="bj-link-arrow" href="/help#samples">{home.samplesLink}<Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="bj-container bj-section bj-split bj-split--reverse" aria-labelledby="brands-title">
    <Photo photo={photos.tins} class="bj-split__photo" sizes="(min-width: 900px) 40vw, 100vw" />
    <div class="bj-stack">
      <h2 id="brands-title">{home.brandsTitle}</h2>
      <p class="bj-lead">{home.brandsBody}</p>
      <ul class="bj-brand-list">
        {sellingBrands.map((b) => <li><a href={`/colours?brand=${b.id}`}>{b.name}</a></li>)}
      </ul>
      <a class="bj-link-arrow" href="/brands">See the brands and prices<Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="bj-container bj-section bj-split bj-closing" aria-labelledby="closing-title">
    <Photo photo={photos.painting} class="bj-split__photo bj-split__photo--wide" sizes="(min-width: 900px) 50vw, 100vw" />
    <div class="bj-stack">
      <h2 id="closing-title">{home.closingTitle}</h2>
      <p class="bj-lead">{home.closingBody}</p>
      <div><a class="bj-button" href="/colour-consultant"><Icon name="camera" />{home.primaryCta}</a></div>
    </div>
  </section>
</Base>
