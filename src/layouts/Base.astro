---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import copy from '../content/copy.json';
import { commerceMode } from '../lib/config';

interface Props {
  title: string;
  description?: string;
  /** Pages that must never be indexed (cart, checkout, orders). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const mode = commerceMode();
const robots = noindex || mode !== 'live' ? 'noindex, nofollow' : 'index, follow';
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F4F0E7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/DMSerifDisplay-Regular.latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-Variable.latin.woff2" as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Big Jo’s Paints" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_ZA" />
    {canonical && <meta property="og:url" content={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <a class="bj-skip bj-button" href="#main">Skip to content</a>
    {mode === 'sandbox' && <p class="bj-test-banner"><span class="bj-container">{copy.testShop}</span></p>}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
